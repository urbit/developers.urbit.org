{
    "github": {
        "silent": true
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "x-robots-tag",
                    "value": "noindex"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/(.*)",
            "destination": "https://docs.urbit.org/",
            "permanent": true
        }
    ]
}
